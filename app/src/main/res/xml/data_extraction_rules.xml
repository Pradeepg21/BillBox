<?xml version="1.0" encoding="utf-8"?>
<!-- Bills never go to cloud backup; a cable or Wi-Fi transfer to a new phone may carry them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
